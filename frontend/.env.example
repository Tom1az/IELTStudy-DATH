# Optional. Where the browser sends API calls. The default, /api/v1, goes through the
# Next.js proxy in next.config.mjs, so the backend needs no CORS.
NEXT_PUBLIC_API_URL=/api/v1

# Where the Express backend runs (read by the Next.js server for the proxy, not by the browser).
# The backend defaults to port 3000, so the frontend runs on 3001 (see package.json).
BACKEND_URL=http://localhost:3000
ADVANCED_URL="http://localhost:4001"