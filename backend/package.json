    "joi": "^18.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@prisma/cli-engine": "0.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.37.0",
    "prettier": "3.9.10",
    "prisma": "8.0.0-rc.22",
