# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Separate, empty database for `npm test`. Tests migrate it and wipe it on every run, so it must
# not be the DATABASE_URL database (the test config refuses to start if they are the same).
# Create it once, e.g. `createdb ieltstudy_test`.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/ieltstudy-test"

# Secret for signing JWTs (Phase 2). Use a long random string.
JWT_SECRET="change-me"

PORT=3000

# Supabase Storage for passage media (Phase 2 uploads). In the Supabase dashboard, create a
# **private** bucket (e.g. `media`) and copy the project URL and the service role key from
# Project Settings -> API. The service role key bypasses all access rules: keep it on the server,
# never in the frontend. Without these, the API still runs: uploads fail and `mediaUrl` is null.
# SUPABASE_URL is only the project origin. Drop any `/rest/v1/` the dashboard shows after it,
# or Storage answers "Invalid path specified in request URL".
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="change-me"
SUPABASE_STORAGE_BUCKET="media"

# Password for the seeded admin, instructor and learner accounts (`npm run seed`). At least 8 characters.
SEED_PASSWORD="change-me-too"
