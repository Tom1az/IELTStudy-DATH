# Must match backend/.env: same database and same JWT secret, so Advanced accepts the
# login tokens the backend issues and reads the same users.
DATABASE_URL="postgresql://postgres:password@localhost:5432/ieltstudy"
JWT_SECRET="change-me"

# Advanced listens here. backend/.env (ADVANCED_SERVICE_URL) and frontend/.env.local
# (ADVANCED_URL) point at it.
PORT=4001